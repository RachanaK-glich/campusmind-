# CampusMind Backend Environment Configuration

PROJECT_NAME="CampusMind API"
ENV="development"
DEBUG=true

# Database (Default: SQLite for instant zero-dependency local run; can be switched to PostgreSQL)
# Example Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/campusmind
DATABASE_URL="sqlite+aiosqlite:///./campusmind.db"

# Vector Database (Default: local directory storage; can be Qdrant Cloud or Docker: http://localhost:6333)
QDRANT_STORAGE_PATH="./qdrant_data"
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="college_docs"

# JWT Security
JWT_SECRET="campusmind-dev-jwt-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM & Embedding Settings
# Supported providers: openai, gemini, local
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Gemini (Fallback/alternative)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# RAG Configuration
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.40
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# File Storage Directory
UPLOAD_DIR="./uploads"

# CORS
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]'
